            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    -- ESP
    local function createESP(player)
        if ESPContainer[player] then return end
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(205, 133, 63)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.Enabled = false

        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 140, 0, 40)
        bb.AlwaysOnTop = true
        bb.ExtentsOffset = Vector3.new(0, 3, 0)
        bb.Enabled = false

        local txt = Instance.new("TextLabel", bb)
        txt.Size = UDim2.new(1, 0, 0, 18)
        txt.BackgroundTransparency = 1
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 12
        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        txt.TextStrokeTransparency = 0.2

        local bg = Instance.new("Frame", bb)
        bg.Size = UDim2.new(0.8, 0, 0, 5)
        bg.Position = UDim2.new(0.1, 0, 0, 20)
        bg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        bg.BorderSizePixel = 0
        Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", bg)
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
        fill.BorderSizePixel = 0
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        ESPContainer[player] = { Highlight = hl, Billboard = bb, HpText = txt, BarFill = fill }
    end

    local function removeESP(player)
        if ESPContainer[player] then
            ESPContainer[player].Highlight:Destroy()
            ESPContainer[player].Billboard:Destroy()
            ESPContainer[player] = nil
        end
    end

    RunService.RenderStepped:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not ESPContainer[player] then createESP(player) end
                local data = ESPContainer[player]
                local char = player.Character
                local enemy = isEnemy(player)

                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                    local hrp = char.HumanoidRootPart
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    data.Highlight.Adornee = char
                    data.Highlight.Parent = char
                    data.Billboard.Adornee = hrp
                    data.Billboard.Parent = char

                    if Config.HitboxEnabled and enemy then
                        hrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                        hrp.Transparency = Config.HitboxTransparency
                        hrp.Color = Config.HitboxColor
                        hrp.Material = Enum.Material.Neon
                        hrp.CanCollide = false
                    else
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                    end

                    if Config.ESPEnabled and enemy then
                        data.Highlight.Enabled = true
                        data.Billboard.Enabled = Config.ShowHP
                        local h = math.clamp(hum.Health, 0, hum.MaxHealth)
                        local p = h / hum.MaxHealth
                        local t = player.Name .. " | " .. math.floor(h) .. " HP"
                        if Config.ShowDistance and LocalPlayer.Character then
                            local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if myHRP then t = t .. " | " .. math.floor((hrp.Position - myHRP.Position).Magnitude) .. "m" end
                        end
                        data.HpText.Text = t
                        data.BarFill.Size = UDim2.new(p, 0, 1, 0)
                        data.BarFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - p), 255 * p, 50)
                    else
                        data.Highlight.Enabled = false
                        data.Billboard.Enabled = false
                    end
                else
                    data.Highlight.Enabled = false
                    data.Billboard.Enabled = false
                end
            end
        end
    end)

    Players.PlayerRemoving:Connect(removeESP)

    LocalPlayer.Idled:Connect(function()
