    -- ============ OPEN/CLOSE ============
    local isOpen = false
    local function toggleUI()
        isOpen = not isOpen
        local normalSize = device == "Mobile" and UDim2.new(0, 340, 0, 420) or UDim2.new(0, 480, 0, 380)
        if isOpen then
            MainFrame.Visible = true
            MainFrame.Size = UDim2.new(0, 0, 0, 0)
            TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back), {Size = normalSize}):Play()
        else
            local tw = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
            tw:Play()
            tw.Completed:Connect(function()
                MainFrame.Visible = false
                MainFrame.Size = normalSize
                for _, l in ipairs(LeafContainer) do if l and l.Parent then l:Destroy() end end
                LeafContainer = {}
            end)
        end
    end

    ToggleIcon.MouseButton1Click:Connect(toggleUI)
    CloseBtn.MouseButton1Click:Connect(toggleUI)

    if device == "PC" then
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.RightShift then toggleUI() end
        end)
    end

    -- ============ 2D LEAVES ============
    local leafColors = {
        Color3.fromRGB(205, 133, 63), Color3.fromRGB(184, 134, 11),
        Color3.fromRGB(160, 82, 45), Color3.fromRGB(178, 34, 34),
        Color3.fromRGB(139, 69, 19)
    }

    local function spawnLeaf()
        if not Config.AutumnEnabled or not MainFrame.Visible then return end
        local leaf = Instance.new("Frame")
        leaf.Size = UDim2.new(0, 18, 0, 18)
        leaf.BackgroundColor3 = leafColors[math.random(1, #leafColors)]
        leaf.BorderSizePixel = 0
        leaf.ZIndex = 5
        leaf.Rotation = math.random(0, 360)
        leaf.Position = UDim2.new(math.random(), 0, -0.1, 0)
        leaf.Parent = LeafLayer
        Instance.new("UICorner", leaf).CornerRadius = UDim.new(0.5, 0)
        table.insert(LeafContainer, leaf)
        local t = math.random(6, 12)
        local tp = UDim2.new(leaf.Position.X.Scale + (math.random(-30, 30)/100), 0, 1.1, 0)
        TweenService:Create(leaf, TweenInfo.new(t, Enum.EasingStyle.Linear), {Position = tp}):Play()
        TweenService:Create(leaf, TweenInfo.new(t, Enum.EasingStyle.Linear), {Rotation = leaf.Rotation + math.random(360, 720)}):Play()
        task.delay(t, function()
            leaf:Destroy()
            for i, l in ipairs(LeafContainer) do if l == leaf then table.remove(LeafContainer, i) break end end
        end)
    end

    task.spawn(function()
        while task.wait(0.6) do
            if Config.AutumnEnabled and MainFrame.Visible then
                if #LeafContainer < Config.LeafCount then spawnLeaf() end
            elseif not MainFrame.Visible then
                for _, l in ipairs(LeafContainer) do if l and l.Parent then l:Destroy() end end
                LeafContainer = {}
            end
        end
    end)

    -- Kill Aura
    task.spawn(function()
        while task.wait(0.5) do
            if Config.KillAuraEnabled and isPremium then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if hum and isEnemy(p) then pcall(function() hum.Health = 0 end) end
                    end
                end
            end
        end
    end)

    -- Health Regen
    task.spawn(function()
        while task.wait(1) do
            if Config.HealthRegen and isPremium and LocalPlayer.Character then
                local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = hum.MaxHealth end
            end
        end
    end)

    -- Auto TP
    task.spawn(function()
        while task.wait(1) do
            if Config.AutoTP and isPremium then
                local closest, shortestDist = nil, 250
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local head = p.Character:FindFirstChild("Head")
                        if head and isEnemy(p) then
                            local d = (head.Position - Camera.CFrame.Position).Magnitude
                            if d < shortestDist then shortestDist = d; closest = head end
                        end
                    end
                end
                if closest and LocalPlayer.Character then
                    local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myHRP then myHRP.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0)) end
                end
            end
        end
    end)

    -- Movement loops
    RunService.RenderStepped:Connect(function()
        if Config.FlyEnabled and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local bv = hrp:FindFirstChild("RoxFly")
                if bv then
                    local dir = Vector3.new(0,0,0)
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
                    bv.Velocity = dir * Config.FlySpeed
                end
            end
        end
    end)

    RunService.Stepped:Connect(function()
        if Config.NoclipEnabled and LocalPlayer.Character then
            for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
            end
        end
    end)

    UserInputService.JumpRequest:Connect(function()
